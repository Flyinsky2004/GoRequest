+		return
+	}
 	req, plan, red, err := a.buildTrackedTabPlan(ctx, tab)
 	if err != nil {
 		cancel()
@@ -283,6 +289,7 @@
 		return
 	}
 	a.attachNetworkToPlan(tab, req, plan, red)
+	a.attachConfirmedNetworkOptions(tab, plan, confirmed)
 
 	tab.cancel = cancel
 	tab.Sending = true
