{
  // VS Code debug configurations for GoRequest Desktop (Go extension + Delve).
  // GoRequest ships a single native desktop app (MyGo Native UI); there is no
  // standalone product CLI.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Desktop: open sample project",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/gorequest-desktop",
      "args": ["-project", "examples/sample-project"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Desktop: open current folder",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/gorequest-desktop",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Demo server (:4010)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/examples/demo-server",
      "args": ["-addr", "127.0.0.1:4010"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Test: core package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/internal/core",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Demo server + Desktop",
      "configurations": ["Demo server (:4010)", "Desktop: open sample project"],
      "stopAll": true
    }
  ]
}
